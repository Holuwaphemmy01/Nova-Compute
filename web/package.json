{
  "name": "@nova/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "kernel:build": "wasm-pack build ../kernel --target web --release --out-dir ../web/src/kernel/pkg --no-pack && node -e \"require('fs').rmSync('src/kernel/pkg/.gitignore',{force:true})\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bch-wc2/interfaces": "0.0.8",
    "@bitauth/libauth": "3.0.0",
    "@wizardconnect/core": "^0.2.10",
    "@wizardconnect/dapp": "^0.2.7",
    "@wizardconnect/react": "^0.2.6",
    "cashscript": "0.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
